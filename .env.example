# --- API Keys ---
# Get your TomTom API key from: https://developer.tomtom.com/
TOMTOM_API_KEY="YOUR_TOMTOM_API_KEY_HERE"

# Get your OpenWeather API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY_HERE"

# --- Kafka Configurations ---
KAFKA_BROKER="localhost:9092"
BROKER="localhost:9092"
RAW_TOPIC="traffic.raw"
KAFKA_TOPIC="traffic_data"

# --- Data Lake Storage Paths ---
# Relative paths where Apache Spark and FastAPI backend read/write the parquet layers
SILVER_PATH="data/silver/"
GOLD_PATH="data/gold/"
silver_path="data/silver/"
gold_path="data/gold/"

# --- Producer Settings ---
# Interval in seconds for TomTom API polling or Simulated traffic generation
TOMTOM_INTERVAL="30"
PRODUCER_INTERVAL="30"
